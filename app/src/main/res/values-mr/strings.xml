    <string name="warn_location_title">लोकेशन अनुपलब्ध</string>
    <string name="warn_location_body">प्रवास पुष्टी आणि अपघात लोकेशन शेअर करण्यासाठी लोकेशन परवानगी द्या.</string>
    <string name="warn_sensor_title">मोशन सेन्सर अनुपलब्ध</string>
    <string name="warn_sensor_body">अॅक्सेलेरोमीटर आढळला नाही. मॅन्युअल SOS उपलब्ध राहील.</string>

    <string name="perm_notifications">सूचना (Notifications)</string>
    <string name="perm_notifications_why">अपघात काउंटडाउन आणि प्रवास सुरक्षा स्थिती दाखवण्यासाठी आवश्यक.</string>
    <string name="perm_notifications_limit">याशिवाय बॅकग्राउंडमध्ये अलर्ट दिसणार नाहीत.</string>

    <string name="perm_location">अचूक लोकेशन (Location)</string>
    <string name="perm_location_why">प्रवासाचा वेग तपासण्यासाठी आणि आपत्कालीन स्थितीत लोकेशन पाठवण्यासाठी.</string>
    <string name="perm_location_limit">लोकेशनशिवाय थेट मॅप लिंक पाठवता येणार नाही.</string>

    <string name="perm_activity">हालचाल ओळख (Activity Recognition)</string>
    <string name="perm_activity_why">वाहनात बसणे आणि उतरणे आपोआप ओळखण्यासाठी.</string>
    <string name="perm_activity_limit">याशिवाय मॅन्युअल ड्रायव्हिंग मोड वापरा.</string>

    <string name="perm_sms">SMS पाठवा (पर्यायी)</string>
    <string name="perm_sms_why">प्रतिसाद न मिळाल्यास आपत्कालीन संपर्कांना आपोआप SMS पाठवण्यासाठी.</string>
    <string name="perm_sms_limit">याशिवाय SMS अॅपमध्ये संदेश तयार उघडेल.</string>

    <string name="perm_call">थेट आपत्कालीन कॉल (पर्यायी)</string>
    <string name="perm_call_why">काउंटडाउननंतर 112 वर आपोआप कॉल करण्यासाठी.</string>
    <string name="perm_call_limit">याशिवाय 112 डायलरमध्ये उघडेल.</string>

    <string name="perm_bluetooth">ब्लूटूथ कार ओळख (पर्यायी)</string>
    <string name="perm_bluetooth_why">कार ऑडिओ कनेक्शनवरून ड्रायव्हिंग ओळख सुधारण्यासाठी.</string>
    <string name="perm_bluetooth_limit">याशिवाय अॅप तुम्ही वाहन चालवत आहात का असे विचारेल.</string>

    <string name="onboard_welcome_title">रस्ते सुरक्षा जी तुमची काळजी घेते</string>
    <string name="onboard_welcome_body">क्रॅशगार्ड वाहन चालवताना संभाव्य अपघात ओळखते, तुम्हाला 45 सेकंद वेळ देते, आणि प्रतिसाद न मिळाल्यास तुमच्या विश्वासू संपर्कांना तुमचे लोकेशन पाठवते.</string>
    <string name="onboard_privacy_title">गोपनीयतेला प्राधान्य</string>
    <string name="onboard_privacy_body">• प्रवासाव्यतिरिक्त कोणतीही लोकेशन ट्रॅकिंग नाही.\n• कॅमेरा किंवा मायक्रोफोन रेकॉर्डिंग नाही.\n• वैद्यकीय माहिती डिव्हाइसवर एन्क्रिप्टेड राहते.\n• लोकेशन शेअरिंग फक्त आपत्कालीन परिस्थितीत 15 मिनिटे चालते.</string>
    <string name="onboard_perm_title">स्वयंचलित क्रॅश सुरक्षा सुरू करा</string>
    <string name="onboard_perm_body">एक-एक करून परवानग्या द्या. तुम्ही त्या कधीही बदलू शकता.</string>
