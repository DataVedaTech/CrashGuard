    <string name="perm_sms">SMS भेजें (वैकल्पिक)</string>
    <string name="perm_sms_why">प्रतिक्रिया न मिलने पर आपातकालीन संपर्कों को स्वतः SMS भेजने के लिए।</string>
    <string name="perm_sms_limit">इसके बिना SMS ऐप में संदेश तैयार खुलेगा।</string>

    <string name="perm_call">सीधी आपातकालीन कॉल (वैकल्पिक)</string>
