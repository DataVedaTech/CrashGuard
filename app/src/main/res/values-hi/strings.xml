    <string name="perm_notifications">सूचनाएँ (Notifications)</string>
    <string name="perm_notifications_why">दुर्घटना काउंटडाउन और यात्रा सुरक्षा स्थिति दिखाने के लिए आवश्यक।</string>
    <string name="perm_notifications_limit">इसके बिना बैकग्राउंड में अलर्ट दिखाई नहीं देंगे।</string>

    <string name="perm_location">सटीक लोकेशन (Location)</string>
    <string name="perm_location_why">यात्रा गति की पुष्टि करने और आपात स्थिति में आपकी लोकेशन भेजने के लिए।</string>
