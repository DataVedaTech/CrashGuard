    <string name="app_name">RakshaKavach</string>
    <string name="app_tagline">Automatic road-crash detection &amp; emergency alert</string>

    <!-- Disclaimers (Spec section 16) -->
    <string name="disclaimer_primary">RakshaKavach is a safety-assistance tool. It does not replace emergency services, professional medical care, or vehicle safety systems.\n\nIn a life-threatening emergency, call 112 immediately.</string>
    <string name="disclaimer_secondary">Automatic crash detection may not detect every crash and may occasionally produce false alerts. Keep your phone charged, enabled, and securely mounted while driving.</string>

