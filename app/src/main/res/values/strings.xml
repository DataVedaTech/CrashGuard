    <!-- Permissions -->
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Required to show the crash check-in countdown and trip protection status.</string>
    <string name="perm_notifications_limit">Without notifications, crash alerts may not appear when the app is in the background.</string>

    <string name="perm_location">Precise Location</string>
    <string name="perm_location_why">Confirms vehicle movement during trips and shares your location with emergency contacts during a crash.</string>
    <string name="perm_location_limit">Without location, automatic trip confirmation and live location links are disabled.</string>

    <string name="perm_activity">Physical Activity Recognition</string>
    <string name="perm_activity_why">Detects when you enter or exit a moving vehicle so protection starts and stops automatically.</string>
    <string name="perm_activity_limit">Without activity recognition, use Manual Driving Mode to start trip protection.</string>

    <string name="perm_sms">Send SMS (Optional)</string>
    <string name="perm_sms_why">Automatically sends emergency SMS alerts with your Google Maps link when you do not respond.</string>
    <string name="perm_sms_limit">Without SMS permission, alerts open in your SMS app for one-tap sending.</string>

    <string name="perm_call">Direct Emergency Call (Optional)</string>
    <string name="perm_call_why">Places an automated call to 112 after the post-crash countdown if enabled.</string>
    <string name="perm_call_limit">Without call permission, tapping Call 112 opens the phone dialer with 112 pre-filled.</string>

    <string name="perm_bluetooth">Bluetooth Car Detection (Optional)</string>
    <string name="perm_bluetooth_why">Recognizes car audio connections to boost driving-detection confidence.</string>
    <string name="perm_bluetooth_limit">Without Bluetooth permission, RakshaKavach asks “Are you driving?” when a trip starts.</string>

    <!-- Onboarding -->
    <string name="onboard_welcome_title">Road safety that checks on you</string>
    <string name="onboard_welcome_body">RakshaKavach detects a likely road crash while you drive, gives you 45 seconds to confirm you are safe, and alerts your trusted contacts with your location if you do not respond.</string>
    <string name="onboard_privacy_title">Privacy by design</string>
    <string name="onboard_privacy_body">• No continuous background tracking when not driving.\n• No camera or microphone recording.\n• Medical profile is encrypted on your device with Android Keystore.\n• Location sharing runs only during an active emergency and stops after 15 minutes or whenever you tap Stop.</string>
    <string name="onboard_perm_title">Enable automatic crash protection</string>
    <string name="onboard_perm_body">Grant permissions one at a time. You can review or revoke any permission at any time in Privacy &amp; Permissions.</string>
